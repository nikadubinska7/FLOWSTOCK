        "responses": {
          "200": {
            "description": "Success; see n8n integration contract"
          },
          "400": {
            "description": "Invalid payload or failed gate"
          },
          "401": {
            "description": "Authentication/administrator access required"
          },
          "409": {
            "description": "Conflict or busy; see error code"
          }
        },
        "security": []
