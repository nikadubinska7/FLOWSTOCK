  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "StartRun": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "snapshot": {
            "type": "string",
            "description": "sportswear (original sportswear), latest (latest planning day), demo (legacy grocery fixture), or completed grocery model-version package ID"
          }
        },
        "required": [
          "snapshot"
        ]
      },
      "Override": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "edits"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "finalQty",
                "comment"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "finalQty": {
                  "type": "integer",
                  "minimum": 0
                },
                "comment": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          }
        }
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "row_ids",
          "create_shipping",
          "reason"
        ],
        "properties": {
          "action": {
            "enum": [
              "approve",
              "reject"
            ]
          },
          "row_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "create_shipping": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ModelAction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "reason"
        ],
        "properties": {
          "action": {
            "enum": [
              "approve",
              "reject",
              "activate",
              "rollback"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "enum": [
              "offline",
              "smoke",
              "freshretailnet"
            ]
          }
        }
      },
      "Monitor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome_batch": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "correlation_id": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
