{
  "name": "flowstock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format:check": "prettier --check src/lib/server src/lib/domain/plan.ts src/lib/domain/constraints.ts src/app/api/v1 src/components/replenishment/RecommendedPlan.tsx src/components/replenishment/ModelHealth.tsx",
    "test:python": ".venv/bin/python -m unittest discover -s tests -p \"test_*.py\"",
    "test:browser": "playwright test",
    "demo:data": "python3 ml/grocery.py"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "postcss": "^8.5.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.4"
  }
}
