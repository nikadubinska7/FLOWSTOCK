OPENAI_API_KEY=
OPENAI_MODEL=
HF_TOKEN=
FLOWSTOCK_API_TOKEN=
FLOWSTOCK_ADMIN_TOKEN=
FLOWSTOCK_AUTH_MODE=local
# Optional absolute Python executable; defaults to project .venv/bin/python
FLOWSTOCK_PYTHON=

# Round 2 Business Central connector (use exact tenant environment and company names)
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=
BC_COMPANY_NAME=

# Databricks AI serving source. Use a personal token only for local development.
# For deployment, use DATABRICKS_CLIENT_ID and DATABRICKS_CLIENT_SECRET (OAuth M2M).
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TOKEN=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=default
DATABRICKS_APP_TABLE_PREFIX=flowstock_app
# Persistent local materialization root used by the deployed app.
FLOWSTOCK_DATABRICKS_RUNS_DIR=
